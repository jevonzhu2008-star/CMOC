	measure 年累计完成L1 =
			
			VAR A = SUM('L1-KFM日报'[累计预测数])
			VAR B = [月累计]
			RETURN
			    A + B
		displayFolder: 日报
		lineageTag: 2a066569-aebe-402d-acd9-9c839cad1879

		formatStringDefinition = FormatKFM()

	measure 年比计划L1 = ```
			
			 IF(
			    SELECTEDVALUE('L1-KFM日报'[单位]) = "%" ,
			    [年累计完成L1] - [年计划L1] ,
			    DIVIDE([年累计完成L1],[年计划L1])
			 )
			```
		lineageTag: 7c4b1d22-9343-4f52-8f26-cbb150ca8d11

		formatStringDefinition = FormatKFM2()

	partition 度量值 = m
		mode: import
		source =
				let
				    源 = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"列 1" = _t]),
				    更改的类型 = Table.TransformColumnTypes(源,{{"列 1", type text}}),
				    删除的列 = Table.RemoveColumns(更改的类型,{"列 1"})
				in
				    删除的列

	annotation PBI_ResultType = Table

