		formatStringDefinition = FormatRatio()

	measure 标题-日报 =
			
			
			VAR v_SelectedDate = SELECTEDVALUE('L1-KFM日报'[标准日期])
			VAR v_FirstDayOfMonth = DATE(YEAR(v_SelectedDate), MONTH(v_SelectedDate), 1)
			VAR v_LastDayOfMonth = EOMONTH(v_SelectedDate, 0)
			VAR v_DaysPassed = DATEDIFF(v_FirstDayOfMonth, v_SelectedDate, DAY) + 1
			VAR v_TotalDays = DATEDIFF(v_FirstDayOfMonth, v_LastDayOfMonth, DAY) + 1
			VAR v_Progress = DIVIDE(v_DaysPassed, v_TotalDays)
			VAR v_Progress2 = IF(NOT ISBLANK(v_SelectedDate), v_Progress, BLANK())
			// 进度百分比文本，如 66.67%
			VAR YearProgressText = FORMAT(v_Progress2, "0.00%")
			VAR ReportYearMonthDayText =
			    // 统计年月+日期+星期，示例：2026年8月05日 星期三
			    FORMAT(v_SelectedDate, "yyyy年M月dd日 ") & FORMAT(v_SelectedDate, "aaaa")
			
			VAR TitlePrefix =
			    // 标题前缀
			    "KFM日度生产指标完成情况（"
			VAR TitleSuffix =
			    // 标题后缀
			    "）年时间进度"
			RETURN
			    // 无日期数据时返回空，避免拼出错误标题
			    IF(
			        NOT ISBLANK(v_SelectedDate),
			        TitlePrefix & ReportYearMonthDayText & TitleSuffix & YearProgressText,
			        BLANK()
			    )
		displayFolder: 辅助
		lineageTag: dc30c013-90ab-409b-bc39-fdbc3568ba9d

