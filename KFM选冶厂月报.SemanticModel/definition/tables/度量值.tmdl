table 度量值
	lineageTag: 3155867a-412f-4412-aba1-d930d6fe7b51

	measure '.' =
			// ------------------------------------------------------------
			// "." —— 布局占位度量值
			// 说明：仅返回一个空格，用于表格/矩阵中制造间隔列，无业务含义
			// ------------------------------------------------------------
			" "
		displayFolder: 辅助
		lineageTag: e7a3b12a-83a8-4420-b280-443476456db1

	measure 月计划 =
			// ------------------------------------------------------------
			// 月计划 —— 当月预测数（当月计划值）
			// 与「月计划」的差异：单位判定由「仅 %」扩充为「% 与 t/t」
			// 特点：按单位智能切换显示格式，返回文本类型
			// ------------------------------------------------------------
			VAR SumValue =
			    // 当月预测数合计
			    SUM('KFM选冶厂月报'[预测数])
			VAR FormatString =
			    // 单位为 % 或 t/t 时保留 2 位小数，其余（如吨）显示带千分位的整数
			    IF(
			        NOT SELECTEDVALUE('KFM选冶厂月报'[单位]) IN {"%", "t/t"},
			        "#,0",
			        "#,0.00"
			    )
			VAR FormattedValue =
			    // 按单位格式化后的文本结果
			    FORMAT(SumValue, FormatString)
			RETURN
			    FormattedValue
		displayFolder: KFM选冶厂月报
		lineageTag: 9574da2d-1ff7-44e7-a7e0-cccdc3fc916d

	measure 月完成 =
			// ------------------------------------------------------------
			// 月完成 —— 当月实际完成数
			// 与「月完成」的差异：单位判定由「仅 %」扩充为「% 与 t/t」
			// 特点：按单位智能切换显示格式，返回文本类型
			// ------------------------------------------------------------
			VAR SumValue =
			    // 当月实际完成数合计
			    SUM('KFM选冶厂月报'[实际数])
			VAR FormatString =
			    // 单位为 % 或 t/t 时保留 2 位小数，其余（如吨）显示带千分位的整数
			    IF(
			        NOT SELECTEDVALUE('KFM选冶厂月报'[单位]) IN {"%", "t/t"},
			        "#,0",
			        "#,0.00"
			    )
			VAR FormattedValue =
			    // 按单位格式化后的文本结果
			    FORMAT(SumValue, FormatString)
			RETURN
			    FormattedValue
		displayFolder: KFM选冶厂月报
		lineageTag: fc665243-de9e-44cf-b181-787dafd11401

	measure 月比计划 =
			// ------------------------------------------------------------
			// 月比计划 —— 当月计划完成率
			// 公式：当月实际完成数 ÷ 当月预测数
			// ------------------------------------------------------------
			VAR ActualValue =
			    // 当月实际完成数
			    SUM('KFM选冶厂月报'[实际数])
			VAR ForecastValue =
			    // 当月预测数（即当月计划）
			    SUM('KFM选冶厂月报'[预测数])
			RETURN
			    // DIVIDE 自动处理分母为 0 或空值，避免除零错误
			    DIVIDE(ActualValue, ForecastValue)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: KFM选冶厂月报
		lineageTag: 4aed6c08-0b00-428f-b3cd-ba9f26db2ecd

	measure 月计划累计 =
			// ------------------------------------------------------------
