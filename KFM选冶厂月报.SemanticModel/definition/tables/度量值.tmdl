			// 用途：KFM 月报中「年累计」列的分组标题
			// ------------------------------------------------------------
			VAR MaxReportDate =
			    // 筛选上下文内的报表最大日期
			    MAX('KFM选冶厂月报'[日期])
			VAR ReportYear =
			    // 最大日期对应的年份
			    YEAR(MaxReportDate)
			RETURN
			    IF(
			        NOT ISBLANK(MaxReportDate),
			        ReportYear & "年累计",
			        BLANK()
			    )
		displayFolder: 辅助
		lineageTag: 1baff191-cc54-4823-9cb5-309556a487fe

	measure 标题-年全年 =
			// ------------------------------------------------------------
			// 标题-年全年 —— 全年表头，如「2026年全年」
			// 用途：KFM 月报中「全年计划/预算」列的分组标题
			// ------------------------------------------------------------
			VAR MaxReportDate =
			    // 筛选上下文内的报表最大日期
			    MAX('KFM选冶厂月报'[日期])
			VAR ReportYear =
			    // 最大日期对应的年份
			    YEAR(MaxReportDate)
			RETURN
			    IF(
			        NOT ISBLANK(MaxReportDate),
			        ReportYear & "年全年",
			        BLANK()
			    )
		displayFolder: 辅助
		lineageTag: 9851be14-e662-4a51-b980-90e1477f7348

	measure 标题-同期年 =
			// ------------------------------------------------------------
			// 标题-同期年 —— 去年同期年份表头，如「2025年」
			// 用途：KFM 月报中「同期年累计」列的分组标题
			// ------------------------------------------------------------
			VAR MaxReportDate =
			    // 筛选上下文内的报表最大日期
			    MAX('KFM选冶厂月报'[日期])
			VAR ReportYear =
			    // 最大日期对应的年份
			    YEAR(MaxReportDate)
			RETURN
			    IF(
			        NOT ISBLANK(MaxReportDate),
			        // 当前年份减 1 即为去年同期年份
			        (ReportYear - 1) & "年",
			        BLANK()
			    )
		displayFolder: 辅助
		lineageTag: 2edb1f3d-5ab9-4b52-915b-9691edcd9664

	partition 度量值 = m
		mode: import
		source =
				let
				    源 = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"列 1" = _t]),
				    更改的类型 = Table.TransformColumnTypes(源,{{"列 1", type text}}),
				    删除的列 = Table.RemoveColumns(更改的类型,{"列 1"})
				in
				    删除的列

	annotation PBI_ResultType = Table

