		displayFolder: KFM选冶厂月报
		lineageTag: 38cd5c00-3ece-4b80-90cc-39620cdaf36a

	measure 年累计完成比计划 =
			// ------------------------------------------------------------
			// 年累计完成比计划 —— 年度累计预算完成率
			// 公式：年累计实际完成数 ÷ 年累计预算数
			// ------------------------------------------------------------
			VAR CumulativeActual =
			    // 年累计实际完成数
			    SUM('KFM选冶厂月报'[累计实际数])
			VAR CumulativeBudget =
			    // 年累计预算数
			    SUM('KFM选冶厂月报'[累计预算数])
			RETURN
			    // DIVIDE 自动处理分母为 0 或空值，避免除零错误
			    DIVIDE(CumulativeActual, CumulativeBudget)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: KFM选冶厂月报
		lineageTag: c405995a-f7b8-49e5-abcc-4940f06860bc

	measure 标题 =
			// ------------------------------------------------------------
			// 标题 —— 动态生成月报头部标题
			// 输出示例：KFM月度生产指标完成情况（2026年8月）年时间进度66.67%
			// 实现：读取筛选上下文内的最大日期，拼接「报表名 + 统计年月 + 年度时间进度」
			// ------------------------------------------------------------
			VAR MaxReportDate =
			    // 筛选上下文内的报表最大日期
			    MAX('KFM选冶厂月报'[日期])
			VAR ReportYearMonthText =
			    // 统计年月文本，如 2026年8月
			    FORMAT(MaxReportDate, "yyyy年M月")
			VAR MaxMonthNum =
			    // 最大日期对应的月份序号（1-12）
			    MONTH(MaxReportDate)
			VAR YearProgressDecimal =
			    // 年度时间进度小数 = 月份 ÷ 12
			    DIVIDE(MaxMonthNum, 12, BLANK())
			VAR YearProgressText =
			    // 进度百分比文本，如 66.67%
			    FORMAT(YearProgressDecimal, "0.00%")
			VAR TitlePrefix =
			    // 标题前缀
			    "KFM月度生产指标完成情况（"
			VAR TitleSuffix =
			    // 标题后缀
			    "）年时间进度"
			RETURN
			    // 无日期数据时返回空，避免拼出错误标题
			    IF(
			        NOT ISBLANK(MaxReportDate),
			        TitlePrefix & ReportYearMonthText & TitleSuffix & YearProgressText,
			        BLANK()
			    )
		displayFolder: 辅助
		lineageTag: 2d7d98c3-f3c4-4c3f-bf40-b5153ee09089

	measure 标题-月份 =
			// ------------------------------------------------------------
			// 标题-月份 —— 报表月份的短文本表头，如「8月」
			// 用途：KFM 月报中「本月」列的分组标题
			// ------------------------------------------------------------
			VAR MaxReportDate =
			    // 筛选上下文内的报表最大日期
			    MAX('KFM选冶厂月报'[日期])
			VAR ReportMonth =
			    // 最大日期对应的月份序号
			    MONTH(MaxReportDate)
			RETURN
			    IF(
			        NOT ISBLANK(MaxReportDate),
			        //「&」会把数字隐式转为文本，故结果为「8月」
			        ReportMonth & "月",
			        BLANK()
			    )
		displayFolder: 辅助
		lineageTag: f9fef871-800a-41ad-81bc-1dbd349b2cd9

