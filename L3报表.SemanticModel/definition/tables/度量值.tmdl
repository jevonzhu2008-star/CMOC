	measure 年累计完成L1 = ```
			
			// 年累计完成 = 累计实际数 + 当月累计实际数
			VAR MonthAccActual = SUM('L1-KFM日报'[当月累计实际数])
			VAR YearToPreMonthAccActual = SUM('L1-KFM日报'[累计实际数])
			VAR Res = 
			    IF(
			        SELECTEDVALUE('L1-KFM日报'[总类别]) = "其他指标" ,
			        BLANK(),
			        MonthAccActual + YearToPreMonthAccActual
			    )
			RETURN
			    Res
