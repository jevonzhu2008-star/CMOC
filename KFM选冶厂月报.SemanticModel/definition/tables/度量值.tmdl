	measure 标题-月报 =
			// ------------------------------------------------------------
			// 标题 —— 动态生成月报头部标题
			// 输出示例：KFM月度生产指标完成情况（2026年8月）年时间进度66.67%
			// 实现：读取筛选上下文内的最大日期，拼接「报表名 + 统计年月 + 年度时间进度」
			// ------------------------------------------------------------
			VAR MaxReportDate =
			    // 筛选上下文内的报表最大日期
			    MAX('KFM选冶厂月报'[日期])
			VAR ReportYearMonthText =
			    // 统计年月文本，如 2026年8月
			    FORMAT(MaxReportDate, "yyyy年M月")
			VAR MaxMonthNum =
			    // 最大日期对应的月份序号（1-12）
			    MONTH(MaxReportDate)
			VAR YearProgressDecimal =
			    // 年度时间进度小数 = 月份 ÷ 12
			    DIVIDE(MaxMonthNum, 12, BLANK())
			VAR YearProgressText =
			    // 进度百分比文本，如 66.67%
			    FORMAT(YearProgressDecimal, "0.00%")
			VAR TitlePrefix =
			    // 标题前缀
			    "KFM月度生产指标完成情况（"
			VAR TitleSuffix =
			    // 标题后缀
			    "）年时间进度"
			RETURN
			    // 无日期数据时返回空，避免拼出错误标题
			    IF(
			        NOT ISBLANK(MaxReportDate),
			        TitlePrefix & ReportYearMonthText & TitleSuffix & YearProgressText,
			        BLANK()
			    )
		displayFolder: 辅助
		lineageTag: 2d7d98c3-f3c4-4c3f-bf40-b5153ee09089

	measure 标题-月份 =
			// ------------------------------------------------------------
			// 标题-月份 —— 报表月份的短文本表头，如「8月」
			// 用途：KFM 月报中「本月」列的分组标题
			// ------------------------------------------------------------
			VAR MaxReportDate =
			    // 筛选上下文内的报表最大日期
			    MAX('KFM选冶厂月报'[日期])
			VAR ReportMonth =
			    // 最大日期对应的月份序号
			    MONTH(MaxReportDate)
			RETURN
			    IF(
			        NOT ISBLANK(MaxReportDate),
			        //「&」会把数字隐式转为文本，故结果为「8月」
			        ReportMonth & "月",
			        BLANK()
			    )
		displayFolder: 辅助
		lineageTag: f9fef871-800a-41ad-81bc-1dbd349b2cd9

	measure 标题-年累计 =
			// ------------------------------------------------------------
			// 标题-年累计 —— 年累计表头，如「2026年累计」
			// 用途：KFM 月报中「年累计」列的分组标题
			// ------------------------------------------------------------
			VAR MaxReportDate =
			    // 筛选上下文内的报表最大日期
			    MAX('KFM选冶厂月报'[日期])
			VAR ReportYear =
			    // 最大日期对应的年份
			    YEAR(MaxReportDate)
			RETURN
			    IF(
			        NOT ISBLANK(MaxReportDate),
			        ReportYear & "年累计",
			        BLANK()
			    )
		displayFolder: 辅助
		lineageTag: 1baff191-cc54-4823-9cb5-309556a487fe

	measure 标题-年全年 =
			// ------------------------------------------------------------
			// 标题-年全年 —— 全年表头，如「2026年全年」
			// 用途：KFM 月报中「全年计划/预算」列的分组标题
			// ------------------------------------------------------------
			VAR MaxReportDate =
			    // 筛选上下文内的报表最大日期
			    MAX('KFM选冶厂月报'[日期])
			VAR ReportYear =
			    // 最大日期对应的年份
			    YEAR(MaxReportDate)
			RETURN
			    IF(
			        NOT ISBLANK(MaxReportDate),
			        ReportYear & "年全年",
			        BLANK()
			    )
		displayFolder: 辅助
		lineageTag: 9851be14-e662-4a51-b980-90e1477f7348

	measure 标题-同期年 =
			// ------------------------------------------------------------
			// 标题-同期年 —— 去年同期年份表头，如「2025年」
			// 用途：KFM 月报中「同期年累计」列的分组标题
			// ------------------------------------------------------------
			VAR MaxReportDate =
			    // 筛选上下文内的报表最大日期
			    MAX('KFM选冶厂月报'[日期])
			VAR ReportYear =
			    // 最大日期对应的年份
			    YEAR(MaxReportDate)
			RETURN
			    IF(
			        NOT ISBLANK(MaxReportDate),
			        // 当前年份减 1 即为去年同期年份
			        (ReportYear - 1) & "年",
			        BLANK()
			    )
		displayFolder: 辅助
		lineageTag: 2edb1f3d-5ab9-4b52-915b-9691edcd9664

