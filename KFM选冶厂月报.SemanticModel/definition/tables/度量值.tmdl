	measure 年比计划 =
			// ------------------------------------------------------------
			// 年比计划 —— 年度累计计划完成率
			// 公式：年累计实际完成数 ÷ 年累计预测数
			// ------------------------------------------------------------
			VAR CumulativeActual =
			    // 年累计实际完成数
			    SUM('KFM选冶厂月报'[累计实际数])
			VAR CumulativeForecast =
			    // 年累计预测数
			    SUM('KFM选冶厂月报'[累计预测数])
			RETURN
			    // DIVIDE 自动处理分母为 0 或空值，避免除零错误
			    DIVIDE(CumulativeActual, CumulativeForecast)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: KFM选冶厂月报
		lineageTag: 3a615cd9-4013-4269-b999-3c8186c5b5fd

	measure 同期年累计完成 =
			// ============================================================
			// 同期年累计完成 —— 去年同期（去年同月）的年累计完成值
			// ------------------------------------------------------------
			// 背景：本模型使用「月份-筛选器」切片器，其取值有两种形态：
			//       ① “最近月份”  → 代表数据中最后一个有实际数的月份
			//       ② 具体月份文本 → 如 “202608”
			// 因此需先将切片器值解析为真实月份，再回退到去年同月取数。
			// ============================================================
			VAR SelectedFilter =
			    // 切片器当前选中值（取自「月份-筛选器」列，而非「月份」列）
			    SELECTEDVALUE('KFM选冶厂月报'[月份-筛选器])
			VAR LatestMonth =
			    // 真实「最近月份」= 有实际数的最大月份（与 M 中 LatestMonth 同口径）
			    CALCULATE(
			        MAX('KFM选冶厂月报'[月份]),
			        'KFM选冶厂月报'[实际数] <> 0,
			        ALL('KFM选冶厂月报')
			    )
			VAR CurrentMonth =
			    // 解析切片器选中值：“最近月份” → LatestMonth；月份文本 → 转为数字
			    SWITCH(
			        TRUE(),
			        SelectedFilter = "最近月份", LatestMonth,
			        NOT ISBLANK(SelectedFilter), VALUE(SelectedFilter),
			        BLANK()
			    )
			VAR PriorYearMonth =
			    // 去年同月：利用 YYYYMM 编码特性，减 100 即得（如 202608 → 202508）
			    CurrentMonth - 100
			RETURN
			    IF(
			        NOT ISBLANK(CurrentMonth),
			        CALCULATE(
			            [年累计完成],
			            // 先清除「月份」与「月份-筛选器」上的全部筛选：
			            // 否则切片器遗留的 [月份-筛选器]=“最近月份” 会与
			            // [月份]=去年同月 互斥，导致整表被清空、结果恒为空。
			            ALL(
			                'KFM选冶厂月报'[月份],
			                'KFM选冶厂月报'[月份-筛选器]
			            ),
			            // 再单独施加「去年同月」这一个筛选条件
			            'KFM选冶厂月报'[月份] = PriorYearMonth
			        ),
			        BLANK()
			    )
		displayFolder: KFM选冶厂月报
		lineageTag: 767269f6-7d34-4e30-988f-00f03d46e4a7

	measure 年计划 =
			// ------------------------------------------------------------
