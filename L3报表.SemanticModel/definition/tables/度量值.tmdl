		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure v铜入矿品位_新口径 = ```
			
			VAR v_CopperMetal =
			    CALCULATE(SUM('L1-KFM日报'[当月累计实际数]), 'L1-KFM日报'[指标名称] = "入磨金属量", 'L1-KFM日报'[产品分类] = "全铜TCu") +
			    CALCULATE(SUM('L1-KFM日报'[累计实际数]),       'L1-KFM日报'[指标名称] = "入磨金属量", 'L1-KFM日报'[产品分类] = "全铜TCu")
			VAR v_RawOreTonnage =
			    CALCULATE(SUM('L1-KFM日报'[当月累计实际数]), 'L1-KFM日报'[指标名称] = "原矿处理量") +
			    CALCULATE(SUM('L1-KFM日报'[累计实际数]),       'L1-KFM日报'[指标名称] = "原矿处理量")
			RETURN
			    DIVIDE(v_CopperMetal, v_RawOreTonnage)
			
			```
		displayFolder: 入选品位
		lineageTag: 9c0d477a-04b5-4db2-aea1-d1d80b6ebbe0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 年累计完成L1_v2 = ```
			
			// 路由逻辑：按二级指标区分指标口径
			VAR Res =
			    SWITCH(
			        TRUE(),
			        // 原矿钴品位TCo：清除L1-KFM日报表筛选，重新完整计算品位
			        SELECTEDVALUE('L1-KFM日报'[二级指标]) = "原矿钴品位TCo",
			        CALCULATE(
			            VAR v_CobaltMetal =
			                CALCULATE(SUM('L1-KFM日报'[当月累计实际数]), 'L1-KFM日报'[指标名称] = "入磨金属量", 'L1-KFM日报'[产品分类] = "全钴TCo") +
			                CALCULATE(SUM('L1-KFM日报'[累计实际数]), 'L1-KFM日报'[指标名称] = "入磨金属量", 'L1-KFM日报'[产品分类] = "全钴TCo")
			            VAR v_RawOreTonnage =
			                CALCULATE(SUM('L1-KFM日报'[当月累计实际数]), 'L1-KFM日报'[指标名称] = "原矿处理量") +
			                CALCULATE(SUM('L1-KFM日报'[累计实际数]), 'L1-KFM日报'[指标名称] = "原矿处理量")
			            RETURN
			                DIVIDE(v_CobaltMetal, v_RawOreTonnage),
			            ALL('L1-KFM日报')
			        ),
			
			        // 原矿铜品位TCu：清除L1-KFM日报表筛选，重新完整计算品位
			        SELECTEDVALUE('L1-KFM日报'[二级指标]) = "原矿铜品位TCu",
			        CALCULATE(
			            VAR v_CopperMetal =
			                CALCULATE(SUM('L1-KFM日报'[当月累计实际数]), 'L1-KFM日报'[指标名称] = "入磨金属量", 'L1-KFM日报'[产品分类] = "全铜TCu") +
			                CALCULATE(SUM('L1-KFM日报'[累计实际数]), 'L1-KFM日报'[指标名称] = "入磨金属量", 'L1-KFM日报'[产品分类] = "全铜TCu")
			            VAR v_RawOreTonnage =
			                CALCULATE(SUM('L1-KFM日报'[当月累计实际数]), 'L1-KFM日报'[指标名称] = "原矿处理量") +
			                CALCULATE(SUM('L1-KFM日报'[累计实际数]), 'L1-KFM日报'[指标名称] = "原矿处理量")
			            RETURN
			                DIVIDE(v_CopperMetal, v_RawOreTonnage),
			            ALL('L1-KFM日报')
			        ),
			
			        // 【变量：当月累计实际数，取自当前筛选上下文】
			        VAR MonthAccActual = SUM('L1-KFM日报'[当月累计实际数])
			
			        // 【变量：往年/前期累计实际数，取自当前筛选上下文】
			        VAR YearToPreMonthAccActual = SUM('L1-KFM日报'[累计实际数])
			        
			        RETURN
			            MonthAccActual + YearToPreMonthAccActual
			    )
			RETURN
			    Res
			
			```
		displayFolder: 日报
		lineageTag: 1720b4a2-48a1-4943-a9cc-a2cc31ebf037

		formatStringDefinition = FormatAmount()

	measure v铜回收率_新口径 = ```
			
			-- 当月累计口径指标 MTD
			VAR v_OreCuMetal_MTD = CALCULATE(SUM('L1-KFM日报'[当月累计实际数]), 'L1-KFM日报'[指标名称]="原矿铜金属量")
			VAR v_LeachResidueQty_MTD = CALCULATE(SUM('L1-KFM日报'[当月累计实际数]), 'L1-KFM日报'[指标名称]="浸出渣量")
			VAR v_ResidueCuGrade_MTD = CALCULATE(SUM('L1-KFM日报'[当月累计实际数]), 'L1-KFM日报'[指标名称]="渣铜品位")
			VAR v_CCD7CuMetal_MTD = CALCULATE(SUM('L1-KFM日报'[当月累计实际数]), 'L1-KFM日报'[指标名称]="CCD7溶液铜金属量")
			VAR v_TailingsReturnWaterCuMetal_MTD = CALCULATE(SUM('L1-KFM日报'[当月累计实际数]), 'L1-KFM日报'[指标名称]="尾矿回水铜金属量")
			
			-- 年度累计口径指标 YTD
			VAR v_OreCuMetal_YTD = CALCULATE(SUM('L1-KFM日报'[累计实际数]), 'L1-KFM日报'[指标名称]="原矿铜金属量")
			VAR v_LeachResidueQty_YTD = CALCULATE(SUM('L1-KFM日报'[累计实际数]), 'L1-KFM日报'[指标名称]="浸出渣量")
			VAR v_ResidueCuGrade_YTD = CALCULATE(SUM('L1-KFM日报'[累计实际数]), 'L1-KFM日报'[指标名称]="渣铜品位")
			VAR v_CCD7CuMetal_YTD = CALCULATE(SUM('L1-KFM日报'[累计实际数]), 'L1-KFM日报'[指标名称]="CCD7溶液铜金属量")
			VAR v_TailingsReturnWaterCuMetal_YTD = CALCULATE(SUM('L1-KFM日报'[累计实际数]), 'L1-KFM日报'[指标名称]="尾矿回水铜金属量")
			
			-- ========= 核心：MTD + YTD 合并相加，代入整套回收率计算 =========
			VAR v_OreCuMetal = v_OreCuMetal_MTD + v_OreCuMetal_YTD
			VAR v_LeachResidueQty = v_LeachResidueQty_MTD + v_LeachResidueQty_YTD
			VAR v_ResidueCuGrade = v_ResidueCuGrade_MTD + v_ResidueCuGrade_YTD
			VAR v_CCD7CuMetal = v_CCD7CuMetal_MTD + v_CCD7CuMetal_YTD
			VAR v_TailingsReturnWaterCuMetal = v_TailingsReturnWaterCuMetal_MTD + v_TailingsReturnWaterCuMetal_YTD
			
			-- 浸出回收率
			VAR v_LeachRecovery =
			    DIVIDE(
			        v_OreCuMetal - (v_LeachResidueQty * v_ResidueCuGrade),
			        v_OreCuMetal
			    )
			-- 洗涤回收率
			VAR v_WashRecovery =
			    DIVIDE(
			        v_OreCuMetal - (v_CCD7CuMetal - v_TailingsReturnWaterCuMetal),
			        v_OreCuMetal
			    )
			VAR v_TotalRecovery = v_LeachRecovery * v_WashRecovery * 0.995
			RETURN
			    IF(NOT ISBLANK(v_OreCuMetal) && v_OreCuMetal > 0, v_TotalRecovery, BLANK())
			
			```
		displayFolder: 入选品位
		lineageTag: e677d72d-d811-4e68-a608-e9dc4891a350

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure v_钴回收率_新口径 = ```
			
			-- 当月累计口径指标 MTD
			VAR v_OreCoMetal_MTD = CALCULATE(SUM('L1-KFM日报'[当月累计实际数]), 'L1-KFM日报'[指标名称]="原矿钴金属量")
			VAR v_LeachResidueQty_MTD = CALCULATE(SUM('L1-KFM日报'[当月累计实际数]), 'L1-KFM日报'[指标名称]="浸出渣量")
			VAR v_ResidueCoGrade_MTD = CALCULATE(SUM('L1-KFM日报'[当月累计实际数]), 'L1-KFM日报'[指标名称]="渣钴品位")
			VAR v_CCD7CoMetal_MTD = CALCULATE(SUM('L1-KFM日报'[当月累计实际数]), 'L1-KFM日报'[指标名称]="CCD7溶液钴金属量")
			VAR v_TailingsReturnWaterCoMetal_MTD = CALCULATE(SUM('L1-KFM日报'[当月累计实际数]), 'L1-KFM日报'[指标名称]="尾矿回水钴金属量")
			
			-- 年度累计口径指标 YTD
			VAR v_OreCoMetal_YTD = CALCULATE(SUM('L1-KFM日报'[累计实际数]), 'L1-KFM日报'[指标名称]="原矿钴金属量")
			VAR v_LeachResidueQty_YTD = CALCULATE(SUM('L1-KFM日报'[累计实际数]), 'L1-KFM日报'[指标名称]="浸出渣量")
			VAR v_ResidueCoGrade_YTD = CALCULATE(SUM('L1-KFM日报'[累计实际数]), 'L1-KFM日报'[指标名称]="渣钴品位")
			VAR v_CCD7CoMetal_YTD = CALCULATE(SUM('L1-KFM日报'[累计实际数]), 'L1-KFM日报'[指标名称]="CCD7溶液钴金属量")
			VAR v_TailingsReturnWaterCoMetal_YTD = CALCULATE(SUM('L1-KFM日报'[累计实际数]), 'L1-KFM日报'[指标名称]="尾矿回水钴金属量")
			
			-- MTD + YTD 合并相加代入公式
			VAR v_OreCoMetal = v_OreCoMetal_MTD + v_OreCoMetal_YTD
			VAR v_LeachResidueQty = v_LeachResidueQty_MTD + v_LeachResidueQty_YTD
			VAR v_ResidueCoGrade = v_ResidueCoGrade_MTD + v_ResidueCoGrade_YTD
			VAR v_CCD7CoMetal = v_CCD7CoMetal_MTD + v_CCD7CoMetal_YTD
			VAR v_TailingsReturnWaterCoMetal = v_TailingsReturnWaterCoMetal_MTD + v_TailingsReturnWaterCoMetal_YTD
			
			-- 浸出回收率
			VAR v_LeachRecovery =
			    DIVIDE(
			        v_OreCoMetal - (v_LeachResidueQty * v_ResidueCoGrade),
			        v_OreCoMetal
			    )
			-- 洗涤回收率
			VAR v_WashRecovery =
			    DIVIDE(
			        v_OreCoMetal - (v_CCD7CoMetal - v_TailingsReturnWaterCoMetal),
			        v_OreCoMetal
			    )
			VAR v_TotalRecovery = v_LeachRecovery * v_WashRecovery * 0.98
			RETURN
			    IF(NOT ISBLANK(v_OreCoMetal) && v_OreCoMetal > 0, v_TotalRecovery, BLANK())
			
			```
		displayFolder: 入选品位
		lineageTag: 366b99f8-b369-44d7-a931-e6464758384c

