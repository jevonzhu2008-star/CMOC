	partition 日报指标映射 = m
		mode: import
		source =
				let
				  // 从 SharePoint 站点定位「指标映射」工作簿，读取「日报」Sheet（首行提升为标题）
				  源 = SharePoint.Files(SharePoint站点, [ApiVersion = 15]),
				  指标映射文件 = Table.SelectRows(源, each Text.Contains([Name], "指标映射") and [Extension] = ".xlsx"){0}[Content],
				  日报表 = Excel.Workbook(指标映射文件, true){[Item = "日报", Kind = "Sheet"]}[Data]
				in
				  日报表

	annotation PBI_ResultType = Table

