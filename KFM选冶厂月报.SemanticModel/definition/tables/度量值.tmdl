			    SUM('KFM选冶厂月报'[累计预算数])
			VAR FormatString =
			    // 单位为 % 或 t/t 时保留 2 位小数，其余显示带千分位的整数
			    IF(
			        NOT SELECTEDVALUE('KFM选冶厂月报'[单位]) IN {"%", "t/t"},
			        "#,0",
			        "#,0.00"
			    )
			VAR FormattedValue =
			    // 按单位格式化后的文本结果
